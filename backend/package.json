{
  "name": "imunikita-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore rules & rules unit tests untuk ImuniKita (Firebase Spark, tanpa Functions/Storage)",
  "scripts": {
    "emulators": "firebase emulators:start --only firestore,auth",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run\"",
    "deploy:dev": "firebase deploy --only firestore:rules,firestore:indexes -P dev",
    "deploy:prod": "firebase deploy --only firestore:rules,firestore:indexes -P prod"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0",
    "vitest": "^3.2.0"
  }
}
